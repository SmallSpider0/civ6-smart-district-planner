    <!-- 模组列表 -->
    <Replace Tag="LOC_SDP_MOD_NAME" Language="zh_Hans_CN">
      <Text>智能区域规划器</Text>
    </Replace>
    <Replace Tag="LOC_SDP_MOD_TEASER" Language="zh_Hans_CN">
      <Text>求解加权相邻加成最高的区域摆放方案，并用地图钉标出。</Text>
    </Replace>
    <Replace Tag="LOC_SDP_MOD_DESCRIPTION" Language="zh_Hans_CN">
      <Text>选择城市、要建的区域和各产出的权重，规划器会在城市三环内穷举所有合法摆放，把最优方案打成地图钉。已有的地图钉不会被挪动。需要 Detailed Map Tacks。请勿与 Auto Map Tacks Planner 等其他区域规划模组同时启用。</Text>
    </Replace>

    <!-- 启动栏与面板 -->
    <Replace Tag="LOC_SDP_LAUNCHBAR_TOOLTIP" Language="zh_Hans_CN">
