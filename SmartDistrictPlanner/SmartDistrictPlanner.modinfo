<?xml version="1.0" encoding="utf-8"?>
<Mod id="d2b8b724-4174-42cb-943c-8036778c68ba" version="8">
  <Properties>
    <Name>LOC_SDP_MOD_NAME</Name>
    <Teaser>LOC_SDP_MOD_TEASER</Teaser>
    <Description>LOC_SDP_MOD_DESCRIPTION</Description>
    <Authors>SmallSpider</Authors>
    <AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>

  <Dependencies>
    <Mod id="4ecfcc62-5471-4435-b295-590df213e8d8" title="Detailed Map Tacks"/>
  </Dependencies>

  <!-- The mod list shows a disabled mod's name from here only: its
       FrontEndActions text is not loaded until the mod is enabled (observed
       2026-10-19). tools/validate.py checks these match Text/*.xml. -->
  <LocalizedText>
    <Text id="LOC_SDP_MOD_NAME">
      <en_US>Smart District Planner</en_US>
      <zh_Hans_CN>智能区域规划器</zh_Hans_CN>
    </Text>
    <Text id="LOC_SDP_MOD_TEASER">
      <en_US>Plans the districts with the highest weighted adjacency bonus for one city, several cities or new city sites, and marks them with map tacks.</en_US>
      <zh_Hans_CN>为单城、多城或新城址规划加权相邻加成最高的区域摆放，并用地图钉标出。</zh_Hans_CN>
    </Text>
    <Text id="LOC_SDP_MOD_DESCRIPTION">
      <en_US>Plans districts for one city, for several cities together (wonders included) and for new city sites. Under your yield weights it looks for the plan with the highest adjacency bonus: small problems are solved exhaustively, larger ones by a search that reports how far the result may be from the best. Preview the plan, then place it as map tacks with district icons; undo is kept with the save. Placement rules and bonuses come from Detailed Map Tacks, so they match what its tacks show. Built districts and your own map tacks are never moved. Requires Detailed Map Tacks. Do not enable together with another district planner such as Auto Map Tacks Planner.</en_US>
      <zh_Hans_CN>为单城、多城联合（含奇观）和新城址规划区域。按你设定的产出权重寻找相邻加成最高的方案：规模小时穷举，规模大时搜索并说明结果离最优还有多远。预览后一键打成带区域图标的地图钉，撤销记录随存档保存。合法性与加成都由 Detailed Map Tacks 计算，与地图钉上显示的一致。已建区域和你自己打的钉不会被挪动。需要 Detailed Map Tacks。请勿与 Auto Map Tacks Planner 等其他区域规划模组同时启用。</zh_Hans_CN>
    </Text>
  </LocalizedText>

  <!-- Mod name and description for the front end once enabled (pitfall 1). -->
  <FrontEndActions>
    <!-- The "open the planner" key, in the game's options (design 18, item 8). -->
    <UpdateDatabase id="sdp_input">
      <File>Config/SDP_Input.xml</File>
    </UpdateDatabase>
    <UpdateText id="sdp_frontend_text">
      <File>Text/SDP_Text_en_US.xml</File>
      <File>Text/SDP_Text_zh_Hans_CN.xml</File>
    </UpdateText>
  </FrontEndActions>

  <InGameActions>
    <UpdateText id="sdp_text">
      <File>Text/SDP_Text_en_US.xml</File>
      <File>Text/SDP_Text_zh_Hans_CN.xml</File>
    </UpdateText>
    <!-- Logic modules, made includable from the panel context. -->
    <ImportFiles id="sdp_scripts">
      <Properties>
        <LoadOrder>14000</LoadOrder>
      </Properties>
      <File>Scripts/SDP_Appeal.lua</File>
      <File>Scripts/SDP_Board.lua</File>
      <File>Scripts/SDP_City.lua</File>
      <File>Scripts/SDP_Coverage.lua</File>
      <File>Scripts/SDP_Land.lua</File>
      <File>Scripts/SDP_Multi.lua</File>
      <File>Scripts/SDP_Overlay.lua</File>
      <File>Scripts/SDP_PageMulti.lua</File>
      <File>Scripts/SDP_PageSites.lua</File>
      <File>Scripts/SDP_Pins.lua</File>
      <File>Scripts/SDP_Preview.lua</File>
      <File>Scripts/SDP_Settings.lua</File>
      <File>Scripts/SDP_Remind.lua</File>
      <File>Scripts/SDP_Rules.lua</File>
      <File>Scripts/SDP_Search.lua</File>
      <File>Scripts/SDP_SiteSolver.lua</File>
      <File>Scripts/SDP_Sites.lua</File>
      <File>Scripts/SDP_Solver.lua</File>
      <File>Scripts/SDP_Task.lua</File>
      <File>Scripts/SDP_Tiers.lua</File>
      <File>Scripts/SDP_Wonders.lua</File>
    </ImportFiles>
    <AddUserInterfaces id="sdp_panel">
      <Properties>
        <Context>InGame</Context>
        <LoadOrder>14000</LoadOrder>
      </Properties>
      <File>UI/SDP_Panel.xml</File>
    </AddUserInterfaces>
  </InGameActions>

  <Files>
    <File>Config/SDP_Input.xml</File>
    <File>Scripts/SDP_Appeal.lua</File>
    <File>Scripts/SDP_Board.lua</File>
    <File>Scripts/SDP_City.lua</File>
    <File>Scripts/SDP_Coverage.lua</File>
    <File>Scripts/SDP_Land.lua</File>
    <File>Scripts/SDP_Multi.lua</File>
    <File>Scripts/SDP_Overlay.lua</File>
    <File>Scripts/SDP_PageMulti.lua</File>
    <File>Scripts/SDP_PageSites.lua</File>
    <File>Scripts/SDP_Pins.lua</File>
    <File>Scripts/SDP_Preview.lua</File>
    <File>Scripts/SDP_Settings.lua</File>
    <File>Scripts/SDP_Remind.lua</File>
    <File>Scripts/SDP_Rules.lua</File>
    <File>Scripts/SDP_Search.lua</File>
    <File>Scripts/SDP_SiteSolver.lua</File>
    <File>Scripts/SDP_Sites.lua</File>
    <File>Scripts/SDP_Solver.lua</File>
    <File>Scripts/SDP_Task.lua</File>
    <File>Scripts/SDP_Tiers.lua</File>
    <File>Scripts/SDP_Wonders.lua</File>
    <File>Text/SDP_Text_en_US.xml</File>
    <File>Text/SDP_Text_zh_Hans_CN.xml</File>
    <File>UI/SDP_Panel.xml</File>
    <File>UI/SDP_Panel.lua</File>
  </Files>
</Mod>
