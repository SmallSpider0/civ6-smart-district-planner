<?xml version="1.0" encoding="utf-8"?>
<Mod id="d2b8b724-4174-42cb-943c-8036778c68ba" version="1">
  <Properties>
    <Name>LOC_SDP_MOD_NAME</Name>
    <Teaser>LOC_SDP_MOD_TEASER</Teaser>
    <Description>LOC_SDP_MOD_DESCRIPTION</Description>
    <Authors>SmallSpider</Authors>
    <AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>

  <Dependencies>
    <Mod id="4ecfcc62-5471-4435-b295-590df213e8d8" title="Detailed Map Tacks"/>
  </Dependencies>

  <!-- The mod list shows a disabled mod's name from here only: its
       FrontEndActions text is not loaded until the mod is enabled (observed
       2026-10-19). tools/validate.py checks these match Text/*.xml. -->
  <LocalizedText>
    <Text id="LOC_SDP_MOD_NAME">
      <en_US>Smart District Planner</en_US>
      <zh_Hans_CN>智能区域规划器</zh_Hans_CN>
    </Text>
    <Text id="LOC_SDP_MOD_TEASER">
      <en_US>Finds the district placement with the highest weighted adjacency bonus and marks it with map tacks.</en_US>
      <zh_Hans_CN>求解加权相邻加成最高的区域摆放方案，并用地图钉标出。</zh_Hans_CN>
    </Text>
    <Text id="LOC_SDP_MOD_DESCRIPTION">
      <en_US>Pick a city, the districts you want and how much each yield matters; the planner searches every legal placement within three rings and pins the best plan on the map. Existing map tacks are never moved. Requires Detailed Map Tacks. Do not enable together with another district planner such as Auto Map Tacks Planner.</en_US>
      <zh_Hans_CN>选择城市、要建的区域和各产出的权重，规划器会在城市三环内穷举所有合法摆放，把最优方案打成地图钉。已有的地图钉不会被挪动。需要 Detailed Map Tacks。请勿与 Auto Map Tacks Planner 等其他区域规划模组同时启用。</zh_Hans_CN>
    </Text>
  </LocalizedText>

  <!-- Mod name and description for the front end once enabled (pitfall 1). -->
  <FrontEndActions>
    <UpdateText id="sdp_frontend_text">
      <File>Text/SDP_Text_en_US.xml</File>
      <File>Text/SDP_Text_zh_Hans_CN.xml</File>
    </UpdateText>
  </FrontEndActions>

  <InGameActions>
    <UpdateText id="sdp_text">
      <File>Text/SDP_Text_en_US.xml</File>
      <File>Text/SDP_Text_zh_Hans_CN.xml</File>
    </UpdateText>
    <!-- Logic modules, made includable from the panel context. -->
    <ImportFiles id="sdp_scripts">
      <Properties>
        <LoadOrder>14000</LoadOrder>
      </Properties>
      <File>Scripts/SDP_City.lua</File>
      <File>Scripts/SDP_Rules.lua</File>
    </ImportFiles>
    <AddUserInterfaces id="sdp_panel">
      <Properties>
        <Context>InGame</Context>
        <LoadOrder>14000</LoadOrder>
      </Properties>
      <File>UI/SDP_Panel.xml</File>
    </AddUserInterfaces>
  </InGameActions>

  <Files>
    <File>Scripts/SDP_City.lua</File>
    <File>Scripts/SDP_Rules.lua</File>
    <File>Text/SDP_Text_en_US.xml</File>
    <File>Text/SDP_Text_zh_Hans_CN.xml</File>
    <File>UI/SDP_Panel.xml</File>
    <File>UI/SDP_Panel.lua</File>
  </Files>
</Mod>
