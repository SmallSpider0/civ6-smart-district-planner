<?xml version="1.0" encoding="utf-8"?>
<!-- Planner panel (opened through the popup queue, pitfall 11) and the
     launch bar button that SDP_Panel.lua injects into /InGame/LaunchBar.
     Every control and attribute follows a precedent in Base/Assets/UI
     (pitfall 8; tools/validate.py checks it). -->
<Context ColorSet="Beige_Black" FontStyle="Shadow">

  <!-- World icons of the map preview (SDP_Preview): outside the window. -->
  <Container ID="PreviewWorldIcons"/>

  <Grid ID="DropShadow" Size="auto,auto" Anchor="L,T" Offset="10,60" Style="DropShadow2" Color="255,255,255,200" AutoSizePadding="25,25" ConsumeMouse="1">
    <Grid ID="Window" Size="560,920" Anchor="C,C" Style="WindowFrameTitle">
      <Container Size="parent,38" Offset="0,4">
        <Label ID="Title" Style="WindowHeader" Anchor="C,C" String="{LOC_SDP_PANEL_TITLE:upper}"/>
      </Container>
      <Button ID="CloseButton" Anchor="R,T" Style="CloseButtonSmall"/>

      <!-- Tabs (as in TradeOverview.xml: a second label for the selected look) -->
      <Stack ID="TabStack" Anchor="C,T" Offset="0,46" StackGrowth="Right" StackPadding="6">
        <GridButton ID="SingleTab" Size="170,34" Style="TabButton">
          <GridButton ID="SingleTabSelected" Size="parent,parent" Style="TabButtonSelected" ConsumeMouseButton="0" ConsumeMouseOver="1"/>
          <Label ID="SingleTabLabel" Anchor="C,C" Offset="0,1" Style="TabFont" String="LOC_SDP_TAB_SINGLE"/>
          <Label ID="SingleTabSelectedLabel" Anchor="C,C" Offset="0,1" Style="TabSelectedFont" String="LOC_SDP_TAB_SINGLE" Hidden="1"/>
        </GridButton>
        <GridButton ID="SitesTab" Size="170,34" Style="TabButton">
          <GridButton ID="SitesTabSelected" Size="parent,parent" Style="TabButtonSelected" ConsumeMouseButton="0" ConsumeMouseOver="1"/>
          <Label ID="SitesTabLabel" Anchor="C,C" Offset="0,1" Style="TabFont" String="LOC_SDP_TAB_SITES"/>
          <Label ID="SitesTabSelectedLabel" Anchor="C,C" Offset="0,1" Style="TabSelectedFont" String="LOC_SDP_TAB_SITES" Hidden="1"/>
        </GridButton>
        <GridButton ID="MultiTab" Size="170,34" Style="TabButton">
          <GridButton ID="MultiTabSelected" Size="parent,parent" Style="TabButtonSelected" ConsumeMouseButton="0" ConsumeMouseOver="1"/>
          <Label ID="MultiTabLabel" Anchor="C,C" Offset="0,1" Style="TabFont" String="LOC_SDP_TAB_MULTI"/>
          <Label ID="MultiTabSelectedLabel" Anchor="C,C" Offset="0,1" Style="TabSelectedFont" String="LOC_SDP_TAB_MULTI" Hidden="1"/>
        </GridButton>
      </Stack>

      <!-- ============ Single city ============ -->
      <Container ID="SinglePage" Anchor="C,T" Offset="0,88" Size="520,820">
      <Stack ID="Body" Anchor="C,T" StackGrowth="Bottom" StackPadding="4">
        <!-- City, and how many districts that take population (feedback 1) -->
        <Container Size="480,28">
          <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_CITY"/>
          <PullDown ID="CityPull" Anchor="L,C" Offset="44,0" Style="PullDownBlue" Size="220,24"/>
          <Container Anchor="R,C" Size="190,28" ToolTip="LOC_SDP_COUNT_TOOLTIP">
            <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_COUNT"/>
            <Button ID="CountLess" Anchor="R,C" Offset="52,0" Style="ArrowButtonLeft"/>
            <Label ID="CountValue" Anchor="R,C" Offset="32,0" Style="BodyTextDark18"/>
            <Button ID="CountMore" Anchor="R,C" Offset="4,0" Style="ArrowButtonRight"/>
          </Container>
        </Container>
        <Label ID="SpecialtyNote" Style="BodyTextDark14" WrapWidth="480"/>

        <!-- Districts in two groups (feedback 6, 7): a click cycles the state.
             The switch keeps partner districts (the harbor and the commercial
             hub, SDP_Rules.Apart) out of one city's picks. -->
        <Container Size="480,24">
          <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_GROUP_SPECIALTY" ToolTip="LOC_SDP_STATES_TOOLTIP"/>
          <Container ID="ApartBox" Anchor="L,C" Offset="138,0" Size="160,24">
            <CheckBox ID="ApartCheck" Anchor="L,C" Style="MainCheckBox"/>
            <Label ID="ApartLabel" Anchor="L,C" Offset="26,0" Style="BodyTextDark14" TruncateWidth="130" TruncatedTooltip="1"/>
          </Container>
          <Label Anchor="R,C" Style="BodyTextDark14" String="LOC_SDP_STATES_LEGEND"/>
        </Container>
        <Stack ID="DistrictStack" StackGrowth="Right" WrapWidth="480" WrapGrowth="Bottom" StackPadding="4"/>
        <Container Size="480,20">
          <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_GROUP_OTHER" ToolTip="LOC_SDP_STATES_OTHER_TOOLTIP"/>
          <Label Anchor="R,C" Style="BodyTextDark14" String="LOC_SDP_STATES_LEGEND_OTHER"/>
        </Container>
        <Stack ID="UtilityStack" StackGrowth="Right" WrapWidth="480" WrapGrowth="Bottom" StackPadding="4"/>

        <!-- Wonders as tags (feedback 2), good places -->
        <Container Size="480,26">
          <Stack Anchor="L,C" StackGrowth="Right" StackPadding="6">
            <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_SINGLE_WONDERS"/>
            <PullDown ID="WonderPull" Anchor="L,C" Style="PullDownBlue" Size="150,24" AutoSizePopUp="1"/>
          </Stack>
          <Stack Anchor="R,C" StackGrowth="Right" StackPadding="6">
            <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_HEATMAP" ToolTip="LOC_SDP_HEATMAP_TOOLTIP"/>
            <PullDown ID="HeatPull" Anchor="L,C" Style="PullDownBlue" Size="150,24" ToolTip="LOC_SDP_HEATMAP_TOOLTIP" AutoSizePopUp="1"/>
          </Stack>
        </Container>
        <Stack ID="WonderChipStack" StackGrowth="Right" WrapWidth="480" WrapGrowth="Bottom" StackPadding="4"/>

        <!-- Weights, one icon family (feedback 3), and the distance cost (feedback 9) -->
        <Stack ID="WeightStack" Anchor="C,T" StackGrowth="Right" StackPadding="0"/>

        <!-- Switches in one row; the full meaning is in each tooltip -->
        <Container Size="480,26">
          <Container Anchor="L,C" Size="116,26" ToolTip="LOC_SDP_LAND">
            <CheckBox ID="LandCheck" Anchor="L,C" Style="MainCheckBox"/>
            <Label Anchor="L,C" Offset="26,0" Style="BodyTextDark14" String="LOC_SDP_LAND_SHORT"/>
          </Container>
          <Container Anchor="L,C" Offset="120,0" Size="116,26" ToolTip="LOC_SDP_ALLOW_FEATURE_REMOVAL">
            <CheckBox ID="FeatureCheck" Anchor="L,C" Style="MainCheckBox"/>
            <Label Anchor="L,C" Offset="26,0" Style="BodyTextDark14" String="LOC_SDP_FEATURE_SHORT"/>
          </Container>
          <Container Anchor="L,C" Offset="240,0" Size="120,26" ToolTip="LOC_SDP_REPLACE_OWN_TOOLTIP">
            <CheckBox ID="ReplaceCheck" Anchor="L,C" Style="MainCheckBox"/>
            <Label ID="ReplaceLabel" Anchor="L,C" Offset="26,0" Style="BodyTextDark14"/>
          </Container>
          <Container Anchor="L,C" Offset="364,0" Size="116,26" ToolTip="LOC_SDP_REMIND_TOOLTIP">
            <CheckBox ID="RemindCheck" Anchor="L,C" Style="MainCheckBox"/>
            <Label Anchor="L,C" Offset="26,0" Style="BodyTextDark14" String="LOC_SDP_REMIND_SHORT"/>
          </Container>
        </Container>
        <Container Size="480,26">
          <Container Anchor="L,C" Size="236,26" ToolTip="LOC_SDP_SWAP_TOOLTIP">
            <CheckBox ID="SwapCheck" Anchor="L,C" Style="MainCheckBox"/>
            <Label Anchor="L,C" Offset="26,0" Style="BodyTextDark14" String="LOC_SDP_SWAP_SHORT"/>
          </Container>
        </Container>

        <!-- Tier, estimate, solve / continue (cancel while running) -->
        <Container Size="480,42">
          <Stack Anchor="L,C" StackGrowth="Right" StackPadding="6">
            <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_TIER_SHORT"/>
            <PullDown ID="TierPull" Anchor="L,C" Style="PullDownBlue" Size="100,24"/>
            <Label ID="Estimate" Anchor="L,C" Style="BodyTextDark14" WrapWidth="76"/>
          </Stack>
          <Stack Anchor="R,C" StackGrowth="Right" StackPadding="4">
            <GridButton ID="SolveButton" Size="110,41" Style="MainButton" String="LOC_SDP_SOLVE"/>
            <GridButton ID="ContinueButton" Size="124,41" Style="MainButton" String="LOC_SDP_CONTINUE"/>
            <GridButton ID="CancelButton" Size="124,41" Style="MainButton" String="LOC_SDP_CANCEL"/>
          </Stack>
        </Container>

        <!-- Results: the solutions (feedback 1), the selected one's districts -->
        <Label ID="Summary" Style="BodyTextDark16" WrapWidth="480"/>
        <Label ID="Quality" Style="BodyTextDark14" WrapWidth="480"/>
        <Stack ID="SolutionStack" StackGrowth="Bottom" StackPadding="2"/>
        <ScrollPanel ID="ResultScroll" Size="480,140" Vertical="1">
          <ScrollBar Anchor="R,C" AnchorSide="I,I" Style="Slider_Blue"/>
          <Stack ID="ResultStack" StackGrowth="Bottom" StackPadding="2"/>
        </ScrollPanel>

        <!-- Map tacks -->
        <Stack Anchor="C,T" StackGrowth="Right" StackPadding="12">
          <GridButton ID="PlaceButton" Size="200,41" Style="MainButton" String="LOC_SDP_PLACE_PINS"/>
          <GridButton ID="UndoButton" Size="200,41" Style="MainButton" String="LOC_SDP_UNDO_PINS"/>
        </Stack>
      </Stack>
      </Container>

      <!-- ============ City sites (step 1) ============ -->
      <Container ID="SitesPage" Anchor="C,T" Offset="0,88" Size="520,820" Hidden="1">
      <Stack ID="SitesBody" Anchor="C,T" StackGrowth="Bottom" StackPadding="4">
        <Container Size="480,30">
          <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_SITES_COUNT"/>
          <Button ID="SitesCountLess" Anchor="L,C" Offset="100,0" Style="ArrowButtonLeft"/>
          <Label ID="SitesCount" Anchor="L,C" Offset="130,0" Style="BodyTextDark18"/>
          <Button ID="SitesCountMore" Anchor="L,C" Offset="150,0" Style="ArrowButtonRight"/>
          <Label Anchor="L,C" Offset="220,0" Style="BodyTextDark16" String="LOC_SDP_SITES_DISTANCE"/>
          <Button ID="SitesDistanceLess" Anchor="L,C" Offset="350,0" Style="ArrowButtonLeft"/>
          <Label ID="SitesDistance" Anchor="L,C" Offset="380,0" Style="BodyTextDark18"/>
          <Button ID="SitesDistanceMore" Anchor="L,C" Offset="404,0" Style="ArrowButtonRight"/>
        </Container>
        <Container Size="480,28">
          <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_SITES_PRESET"/>
          <PullDown ID="SitesPresetPull" Anchor="L,C" Offset="100,0" Style="PullDownBlue" Size="180,24"/>
        </Container>
        <Stack ID="SitesWeightStack" Anchor="C,T" StackGrowth="Right" StackPadding="0"/>
        <Stack ID="SitesWeightStack2" Anchor="C,T" StackGrowth="Right" StackPadding="0"/>
        <!-- The districts each site is scored with: its best few (feedback 8) -->
        <Container Size="480,24">
          <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_SITES_PLAN"/>
          <Container Anchor="R,C" Size="170,24" ToolTip="LOC_SDP_SITES_PLAN_COUNT_TOOLTIP">
            <Label Anchor="L,C" Style="BodyTextDark14" String="LOC_SDP_SITES_PLAN_COUNT"/>
            <Button ID="SitesPlanLess" Anchor="R,C" Offset="52,0" Style="ArrowButtonLeft"/>
            <Label ID="SitesPlanValue" Anchor="R,C" Offset="32,0" Style="BodyTextDark18"/>
            <Button ID="SitesPlanMore" Anchor="R,C" Offset="4,0" Style="ArrowButtonRight"/>
          </Container>
        </Container>
        <Stack ID="SitesDistrictStack" StackGrowth="Right" WrapWidth="480" WrapGrowth="Bottom" StackPadding="4"/>
        <Container Size="480,42">
          <Stack Anchor="L,C" StackGrowth="Right" StackPadding="6">
            <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_TIER_SHORT"/>
            <PullDown ID="SitesTierPull" Anchor="L,C" Style="PullDownBlue" Size="100,24"/>
            <Label ID="SitesEstimate" Anchor="L,C" Style="BodyTextDark14" WrapWidth="76"/>
          </Stack>
          <Stack Anchor="R,C" StackGrowth="Right" StackPadding="4">
            <GridButton ID="SitesSolveButton" Size="110,41" Style="MainButton" String="LOC_SDP_SOLVE"/>
            <GridButton ID="SitesContinueButton" Size="124,41" Style="MainButton" String="LOC_SDP_CONTINUE"/>
            <GridButton ID="SitesCancelButton" Size="124,41" Style="MainButton" String="LOC_SDP_CANCEL"/>
          </Stack>
        </Container>
        <Label ID="SitesSummary" Style="BodyTextDark16" WrapWidth="480"/>
        <Label ID="SitesQuality" Style="BodyTextDark14" WrapWidth="480"/>
        <Stack ID="SitesSolutionStack" StackGrowth="Bottom" StackPadding="2"/>
        <ScrollPanel ID="SitesResultScroll" Size="480,190" Vertical="1">
          <ScrollBar Anchor="R,C" AnchorSide="I,I" Style="Slider_Blue"/>
          <Stack ID="SitesResultStack" StackGrowth="Bottom" StackPadding="2"/>
        </ScrollPanel>
        <Stack Anchor="C,T" StackGrowth="Right" StackPadding="12">
          <GridButton ID="SitesPlaceButton" Size="200,41" Style="MainButton" String="LOC_SDP_SITES_PLACE"/>
          <GridButton ID="SitesUndoButton" Size="200,41" Style="MainButton" String="LOC_SDP_UNDO_PINS"/>
        </Stack>
      </Stack>
      </Container>

      <!-- ============ Several cities (step 2) ============ -->
      <Container ID="MultiPage" Anchor="C,T" Offset="0,88" Size="520,820" Hidden="1">
      <Stack ID="MultiBody" Anchor="C,T" StackGrowth="Bottom" StackPadding="4">
        <Label Style="BodyTextDark16" String="LOC_SDP_MULTI_CITIES"/>
        <ScrollPanel ID="MultiCityScroll" Size="480,72" Vertical="1">
          <ScrollBar Anchor="R,C" AnchorSide="I,I" Style="Slider_Blue"/>
          <Stack ID="MultiCityStack" StackGrowth="Bottom" StackPadding="2"/>
        </ScrollPanel>
        <Container Size="480,28">
          <Stack Anchor="L,C" StackGrowth="Right" StackPadding="6">
            <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_MULTI_PLAN_FOR"/>
            <PullDown ID="MultiPlanPull" Anchor="L,C" Style="PullDownBlue" Size="200,24" AutoSizePopUp="1"/>
          </Stack>
          <PullDown ID="MultiTemplatePull" Anchor="R,C" Style="PullDownBlue" Size="150,24" AutoSizePopUp="1"/>
        </Container>
        <Container Size="480,24">
          <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_GROUP_SPECIALTY" ToolTip="LOC_SDP_STATES_TOOLTIP"/>
          <Container ID="MultiApartBox" Anchor="L,C" Offset="138,0" Size="210,24">
            <CheckBox ID="MultiApartCheck" Anchor="L,C" Style="MainCheckBox"/>
            <Label ID="MultiApartLabel" Anchor="L,C" Offset="26,0" Style="BodyTextDark14" TruncateWidth="184" TruncatedTooltip="1"/>
          </Container>
          <Container Anchor="R,C" Size="136,22" ToolTip="LOC_SDP_COUNT_TOOLTIP_MULTI">
            <Label Anchor="L,C" Style="BodyTextDark14" String="LOC_SDP_COUNT_PER_CITY"/>
            <Button ID="MultiCountLess" Anchor="R,C" Offset="52,0" Style="ArrowButtonLeft"/>
            <Label ID="MultiCountValue" Anchor="R,C" Offset="32,0" Style="BodyTextDark18"/>
            <Button ID="MultiCountMore" Anchor="R,C" Offset="4,0" Style="ArrowButtonRight"/>
          </Container>
        </Container>
        <Stack ID="MultiDistrictStack" StackGrowth="Right" WrapWidth="480" WrapGrowth="Bottom" StackPadding="4"/>
        <Container Size="480,20">
          <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_GROUP_OTHER" ToolTip="LOC_SDP_STATES_OTHER_TOOLTIP"/>
          <Label Anchor="R,C" Style="BodyTextDark14" String="LOC_SDP_STATES_LEGEND_OTHER"/>
        </Container>
        <Stack ID="MultiUtilityStack" StackGrowth="Right" WrapWidth="480" WrapGrowth="Bottom" StackPadding="4"/>
        <Container Size="480,26">
          <Stack Anchor="L,C" StackGrowth="Right" StackPadding="6">
            <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_MULTI_WONDERS"/>
            <PullDown ID="MultiWonderPull" Anchor="L,C" Style="PullDownBlue" Size="170,24" AutoSizePopUp="1"/>
          </Stack>
        </Container>
        <Stack ID="MultiWonderChipStack" StackGrowth="Right" WrapWidth="480" WrapGrowth="Bottom" StackPadding="4"/>
        <Stack ID="MultiWeightStack" Anchor="C,T" StackGrowth="Right" StackPadding="0"/>
        <Container Size="480,26">
          <Container Anchor="L,C" Size="150,26" ToolTip="LOC_SDP_LAND">
            <CheckBox ID="MultiLandCheck" Anchor="L,C" Style="MainCheckBox"/>
            <Label Anchor="L,C" Offset="26,0" Style="BodyTextDark14" String="LOC_SDP_LAND_SHORT"/>
          </Container>
          <Container Anchor="L,C" Offset="160,0" Size="180,26" ToolTip="LOC_SDP_REPLACE_OWN_MULTI_TOOLTIP">
            <CheckBox ID="MultiReplaceCheck" Anchor="L,C" Style="MainCheckBox"/>
            <Label ID="MultiReplaceLabel" Anchor="L,C" Offset="26,0" Style="BodyTextDark14"/>
          </Container>
          <Container Anchor="L,C" Offset="350,0" Size="130,26" ToolTip="LOC_SDP_REMIND_TOOLTIP">
            <CheckBox ID="MultiRemindCheck" Anchor="L,C" Style="MainCheckBox"/>
            <Label Anchor="L,C" Offset="26,0" Style="BodyTextDark14" String="LOC_SDP_REMIND_SHORT"/>
          </Container>
        </Container>
        <Container Size="480,26">
          <Container Anchor="L,C" Size="236,26" ToolTip="LOC_SDP_SWAP_TOOLTIP">
            <CheckBox ID="MultiSwapCheck" Anchor="L,C" Style="MainCheckBox"/>
            <Label Anchor="L,C" Offset="26,0" Style="BodyTextDark14" String="LOC_SDP_SWAP_SHORT"/>
          </Container>
        </Container>
        <Container Size="480,42">
          <Stack Anchor="L,C" StackGrowth="Right" StackPadding="6">
            <Label Anchor="L,C" Style="BodyTextDark16" String="LOC_SDP_TIER_SHORT"/>
            <PullDown ID="MultiTierPull" Anchor="L,C" Style="PullDownBlue" Size="100,24"/>
            <Label ID="MultiEstimate" Anchor="L,C" Style="BodyTextDark14" WrapWidth="76"/>
          </Stack>
          <Stack Anchor="R,C" StackGrowth="Right" StackPadding="4">
            <GridButton ID="MultiSolveButton" Size="110,41" Style="MainButton" String="LOC_SDP_SOLVE"/>
            <GridButton ID="MultiContinueButton" Size="124,41" Style="MainButton" String="LOC_SDP_CONTINUE"/>
            <GridButton ID="MultiCancelButton" Size="124,41" Style="MainButton" String="LOC_SDP_CANCEL"/>
          </Stack>
        </Container>
        <Label ID="MultiSummary" Style="BodyTextDark16" WrapWidth="480"/>
        <Label ID="MultiQuality" Style="BodyTextDark14" WrapWidth="480"/>
        <Stack ID="MultiSolutionStack" StackGrowth="Bottom" StackPadding="2"/>
        <ScrollPanel ID="MultiResultScroll" Size="480,96" Vertical="1">
          <ScrollBar Anchor="R,C" AnchorSide="I,I" Style="Slider_Blue"/>
          <Stack ID="MultiResultStack" StackGrowth="Bottom" StackPadding="2"/>
        </ScrollPanel>
        <Stack Anchor="C,T" StackGrowth="Right" StackPadding="12">
          <GridButton ID="MultiPlaceButton" Size="200,41" Style="MainButton" String="LOC_SDP_PLACE_PINS"/>
          <GridButton ID="MultiUndoButton" Size="200,41" Style="MainButton" String="LOC_SDP_UNDO_PINS"/>
        </Stack>
      </Stack>
      </Container>
    </Grid>
  </Grid>

  <!-- One district in a three-column grid: a click cycles its state
       (required / candidate / not wanted / automatic). The selected look
       marks required and automatic ones; dark text goes with it. -->
  <Instance Name="DistrictCell">
    <GridButton ID="Root" Size="156,26" Style="ButtonControl">
      <!-- The selected look: a plain grid with the texture of the
           TabButtonSelected style (Civ6_Styles.xml, TabButtonSelectedGrid).
           A GridButton there, as on the game's tabs, takes the mouse and the
           cell could not be clicked once selected (2026-10-21). -->
      <Grid ID="Selected" Size="parent,parent" Texture="Controls_Tab" SliceStart="0,136" SliceCorner="21,16" Hidden="1"/>
      <Image ID="Icon" Anchor="L,C" Offset="2,0" Size="26,26"/>
      <Label ID="Name" Anchor="L,C" Offset="30,0" Style="FontNormal14" TruncateWidth="80" TruncatedTooltip="1"/>
      <Label ID="NameDark" Anchor="L,C" Offset="30,0" Style="BodyTextDark14" TruncateWidth="80" TruncatedTooltip="1" Hidden="1"/>
      <Label ID="State" Anchor="R,C" Offset="9,0" Style="FontNormal14"/>
      <Label ID="StateDark" Anchor="R,C" Offset="9,0" Style="BodyTextDark14" Hidden="1"/>
    </GridButton>
  </Instance>

  <!-- A district that can be ticked, in a three-column grid. -->
  <Instance Name="CheckCell">
    <Container ID="Root" Size="156,26">
      <CheckBox ID="Check" Anchor="L,C" Style="MainCheckBox"/>
      <Image ID="Icon" Anchor="L,C" Offset="24,0" Size="26,26"/>
      <Label ID="Name" Anchor="L,C" Offset="52,0" Style="BodyTextDark14" TruncateWidth="100" TruncatedTooltip="1"/>
    </Container>
  </Instance>

  <!-- A chosen wonder; a click takes it off the list. -->
  <Instance Name="WonderChip">
    <GridButton ID="Root" Size="120,24" Style="ButtonControl">
      <Label ID="Name" Anchor="C,C" Style="FontNormal14"/>
    </GridButton>
  </Instance>

  <Instance Name="WeightColumn">
    <Container ID="Root" Size="60,52" ConsumeMouseOver="1">
      <!-- The game's font icons: one family for every column (feedback 3). -->
      <Label ID="Glyph" Anchor="C,T" Offset="0,2" Style="BodyTextDark18"/>
      <Button ID="Less" Anchor="L,B" Offset="2,2" Style="ArrowButtonLeft"/>
      <Label ID="Value" Anchor="C,B" Offset="0,6" Style="BodyTextDark14"/>
      <Button ID="More" Anchor="R,B" Offset="2,2" Style="ArrowButtonRight"/>
    </Container>
  </Instance>

  <Instance Name="ResultRow">
    <Container ID="Root" Size="460,40" ConsumeMouseOver="1">
      <Image ID="Icon" Anchor="L,C" Size="32,32"/>
      <Label ID="Name" Anchor="L,T" Offset="40,2" Style="BodyTextDark16"/>
      <Label ID="Detail" Anchor="L,T" Offset="40,21" Style="BodyTextDark14"/>
    </Container>
  </Instance>

  <Instance Name="CityRow">
    <Container ID="Root" Size="480,28">
      <CheckBox ID="Check" Anchor="L,C" Style="MainCheckBox"/>
      <Image ID="Icon" Anchor="L,C" Offset="24,0" Size="26,26"/>
      <Label ID="Name" Anchor="L,C" Offset="54,0" Style="BodyTextDark16"/>
      <Label ID="Detail" Anchor="R,C" Offset="12,0" Style="BodyTextDark14"/>
    </Container>
  </Instance>

  <!-- One solution: a selectable row; selecting it previews it on the map. -->
  <Instance Name="SolutionRow">
    <GridButton ID="Root" Size="480,30" Style="ButtonControl">
      <Grid ID="Selected" Size="parent,parent" Texture="Controls_Tab" SliceStart="0,136" SliceCorner="21,16" Hidden="1"/>
      <!-- Light text on the dark button; dark text on the light selected look
           (SDP_UI.SolutionRow shows one pair). -->
      <Label ID="Name" Anchor="L,C" Offset="10,0" Style="FontNormal16"/>
      <Label ID="Detail" Anchor="R,C" Offset="10,0" Style="FontNormal14"/>
      <Label ID="NameDark" Anchor="L,C" Offset="10,0" Style="BodyTextDark16" Hidden="1"/>
      <Label ID="DetailDark" Anchor="R,C" Offset="10,0" Style="BodyTextDark14" Hidden="1"/>
    </GridButton>
  </Instance>

  <!-- Map preview icon (as AMT's PreviewMapIcon and MapPinManager.xml). -->
  <Instance Name="SDP_PreviewIcon">
    <WorldAnchor ID="Anchor">
      <Container Anchor="C,B" Size="48,48">
        <Image Size="59,79" Texture="MapPin" Anchor="C,T" Offset="1,-16"/>
        <Image Size="50,50" TextureOffset="0,0" Texture="MapPinFlag" Anchor="C,T"/>
        <Image ID="Icon" Anchor="C,T" Offset="0,9" Size="32,32"/>
        <Grid ID="TextBacking" Style="YieldBacking" Size="auto,24" Anchor="C,B" Color="0,0,0,180" Offset="1,-17">
          <Label ID="Text" Anchor="C,C" Style="YieldBonusText"/>
        </Grid>
      </Container>
    </WorldAnchor>
  </Instance>

  <!-- Same shape as the game's LaunchBarItem / LaunchBarPinInstance (LaunchBar.xml). -->
  <Instance Name="SDP_LaunchBarItem">
